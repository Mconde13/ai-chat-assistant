ANTHROPIC_API_KEY=
SUPABASE_URL=
# Publishable key: read-only via RLS, used by the customer chat (/ask)
SUPABASE_KEY=
# Secret key: full access, used by the owner routes and embed_knowledge.py
SUPABASE_SECRET_KEY=
VOYAGE_API_KEY=
# Comma-separated list of emails allowed to use the owner dashboard
OWNER_EMAIL=

# Optional Claude model settings. Without them the app uses claude-sonnet-5-5 everywhere
# (claude-sonnet-4-5 still works until Anthropic retires it on 2026-11-30).
# BOT_MODEL moves /ask, the query rewriter and the owner routes together;
# REWRITE_MODEL and OWNER_MODEL override the rewriter and the owner routes on their own.
# BOT_EFFORT (low/medium/high) is only sent to claude-*-5 models.
# BOT_MODEL=claude-sonnet-5-5   # the default; set it to pick another model
# REWRITE_MODEL=
# OWNER_MODEL=
# BOT_EFFORT=low

# Used ONLY by eval.py, calibrate_judge.py and eval_server.py, never by the live app. Use a different key
# from ANTHROPIC_API_KEY, created in its own Console workspace with a monthly spend limit, so testing
# can never use up the credit the live site needs. Do not set this in Railway.
EVAL_ANTHROPIC_API_KEY=
